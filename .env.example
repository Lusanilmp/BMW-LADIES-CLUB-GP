# ============================================================
# BMW Ladies Club GP — environment variables (PLACEHOLDERS ONLY)
# Set these in Netlify → Site configuration → Environment variables.
# NEVER commit real values. This file is not published (build copies only public files).
# ============================================================

# ---- PRIVATE (server-side: Netlify Functions only) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # SECRET — never in client code
SUPABASE_ANON_KEY=your-anon-public-key                 # used by article/sitemap functions
IP_HASH_SALT=a-long-random-string                      # salts hashed IPs used for rate limiting
SITE_URL=https://bmwladiesclubgp.co.za
# ALLOWED_ORIGINS=https://bmwladiesclubgp.co.za,https://your-site.netlify.app   # optional

# Optional social import (only when official API access exists)
# INSTAGRAM_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=

# ---- PUBLIC (injected into the browser config at build time by scripts/build.js) ----
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key          # safe to expose; protected by RLS
PUBLIC_WHATSAPP_NUMBER=                                # digits only, e.g. 27XXXXXXXXX — confirm with the club
PUBLIC_CLUB_EMAIL=
PUBLIC_CLUB_PHONE=
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=
# PUBLIC_MEMBERSHIP_OPEN=true
